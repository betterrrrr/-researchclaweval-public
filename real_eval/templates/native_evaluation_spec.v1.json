{
  "spec_version": "1.0",
  "campaign": {
    "campaign_id": "replace-me-topic-model-synchronized-v1",
    "comparison_mode": "synchronized_primary",
    "recovery_policy": "separate_campaign",
    "primary_attempt_policy": "one_fresh_attempt_per_framework",
    "freeze_manifest": "real_eval/config/replace_me_topic_model.freeze.json",
    "framework_ids": [
      "01",
      "02",
      "03",
      "04",
      "05",
      "06",
      "07"
    ],
    "experiment_budget": {
      "minimum": 2,
      "maximum": 2
    },
    "timeout_seconds": 3600,
    "fresh_run_root_required": true
  },
  "topic_adapter": {
    "topic_id": "replace_me_topic",
    "contract_file": "automation/replace_me_contract.md",
    "dataset_env": "REPLACE_ME_DATASET_ROOT",
    "framework_dataset_mount": "/data/replace_me_topic",
    "input_generator": "automation/scripts/generate_replace_me_native_inputs.py",
    "official_scorer": "automation/scripts/run_replace_me_official_score.py",
    "run_validator": "automation/scripts/validate_replace_me_run.py",
    "selection_score_policy": "framework_visible_validation_only",
    "official_score_owner": "host",
    "primary_metric": "replace_me_primary_metric",
    "required_trace_fields": [
      "framework_native_execution",
      "consumed_topic_input",
      "workspace_trace_root",
      "framework_internal_model",
      "framework_internal_api_base_url",
      "experiments",
      "selected_experiment_id",
      "idea_artifact",
      "idea_locked_before_experiments"
    ],
    "required_framework_artifacts": [
      "predictions.jsonl",
      "research_idea.json",
      "experiment_trace.json",
      "final_report.md"
    ],
    "official_score_artifact": "score.json",
    "host_only_inputs": [],
    "framework_visible_inputs": [
      "dataset",
      "contract",
      "input_manifest",
      "validation_scorer"
    ],
    "shared_prompt_sources": [
      "automation/replace_me_contract.md",
      "automation/scripts/generate_replace_me_native_inputs.py"
    ]
  },
  "model_adapter": {
    "variant": "replace_me_variant",
    "model_id": "replace-me-model",
    "provider_config": "api/replace_me_container.toml",
    "wire_protocol": "responses",
    "container_base_url": "http://host.docker.internal:9999/v1",
    "required_env": [
      "OPENAI_BASE_URL",
      "OPENAI_API_KEY",
      "OPENAI_MODEL"
    ],
    "relay_preflight": "real_eval/scripts/preflight_replace_me_relay.sh",
    "public_provider_forbidden": true,
    "effective_model_evidence_required": true,
    "runtime_policy": {
      "compact_experiment_ledger_required": true,
      "runtime_package_install_forbidden": true,
      "remote_request_budget": null,
      "minimum_batch_size": null
    }
  },
  "ownership": {
    "framework_responsibilities": [
      "planning",
      "experiment_design",
      "experiment_execution",
      "comparison",
      "selection",
      "analysis",
      "final_artifact_delivery"
    ],
    "host_responsibilities": [
      "input_projection",
      "lifecycle_management",
      "official_scoring",
      "output_validation",
      "packaging"
    ],
    "host_artifact_backfill_forbidden": true
  },
  "ideation_policy": {
    "framework_owns_method_choice": true,
    "host_method_prescription_forbidden": true,
    "prescribed_methods": [],
    "idea_artifact": "research_idea.json",
    "idea_locked_before_experiments": true,
    "allowed_host_constraints": [
      "topic_question",
      "data_visibility",
      "train_validation_split",
      "official_metric",
      "compute_budget",
      "wall_clock_budget",
      "request_budget",
      "experiment_count_range",
      "available_dependencies",
      "network_policy",
      "safety_policy",
      "output_schema"
    ],
    "forbidden_host_constraints": [
      "algorithm_family",
      "feature_representation",
      "model_architecture",
      "hyperparameters",
      "experiment_sequence",
      "selected_method"
    ]
  },
  "workspace_policy": {
    "runtime_workspace": "/workspace",
    "fresh_physical_workspace_required": true,
    "dataset_read_only": true,
    "contract_read_only": true,
    "repository_root_writable_mount_forbidden": true
  },
