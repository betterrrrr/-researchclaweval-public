# =============================================================================
# ai_researcher_runtime.Dockerfile
# Outer runtime image for AI-Researcher evaluation containers.
#
# Reproducibility guarantees:
#   1. Base image pinned by digest (not a mutable tag).
#   2. All apt packages resolved from a dated snapshot.debian.org archive.
#   3. All pip-installed Python wheels hash-locked via --require-hashes.
#   4. No credentials, API keys, tokens, or environment secrets baked in.
#   5. No build-time source code or run residue baked in (COPY of source is
#      the caller's responsibility at container start).
# =============================================================================

# ---- Base image (pinned digest) --------------------------------------------
# pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime
FROM pytorch/pytorch@sha256:3e5c6b74e5b2c7a5e3f0b0c1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2

USER root
WORKDIR /workplace

# ---- Environment hardening ---------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    ANONYMIZED_TELEMETRY=false \
    PIP_NO_CACHE_DIR=1 \
    PIP_REQUIRE_HASHES=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# ---- Apt snapshot (dated) ----------------------------------------------------
# Snapshot: snapshot.debian.org/archive/debian/20260812T000000Z/
# This freezes the package versions for ALL apt-get installs below.
RUN echo "Acquire::Check-Valid-Until false;" > /etc/apt/apt.conf.d/99no-check-valid-until \
    && echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260812T000000Z/ bookworm main contrib non-free non-free-firmware" > /etc/apt/sources.list \
    && echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260812T000000Z/ bookworm-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list \
    && echo "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260812T000000Z/ bookworm-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list

# ---- System packages (hash-locked via apt snapshot) --------------------------
# All packages are resolved from the dated snapshot above; no version bumps
# unless the snapshot date is advanced.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        wget \
        curl \
        gnupg \
        unzip \
        zip \
        xvfb \
        xauth \
        x11vnc \
        tigervnc-tools \
        supervisor \
        net-tools \
        netcat-traditional \
        procps \
        git \
        tmux \
        tree \
        rsync \
        lsof \
        less \
        vim \
        jq \
        file \
        grep \
        gawk \
        sed \
        poppler-utils \
        wkhtmltopdf \
        antiword \
        unrtf \
        catdoc \
        csvkit \
        xmlstarlet \
        iputils-ping \
        dnsutils \
        sudo \
        fontconfig \
        fonts-liberation \
        fonts-dejavu \
        fonts-dejavu-core \
        fonts-dejavu-extra \
        libgconf-2-4 \
        libxss1 \
        libnss3 \
        libnspr4 \
        libasound2 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libgtk-3-0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        xdg-utils \
        dbus \
        python3-numpy \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb

# ---- Python wheels (hash-locked via requirements-hashes.txt) -----------------
# The requirements-hashes.txt file contains every Python package plus its
# SHA-256 hash, generated by `pip freeze` piped through `pip hash`.
# Run `pip install --require-hashes -r requirements-hashes.txt` to verify.

COPY ai_researcher_runtime.requirements-hashes.txt /workplace/requirements-hashes.txt

# Uninstall pre-loaded torch to replace with the pinned version.
RUN pip uninstall -y torch torchvision torchaudio 2>/dev/null; exit 0

# Install pinned PyTorch 1.13.1 + CUDA 11.6 (with index URL).
# NOTE: --require-hashes is incompatible with --extra-index-url for the same
# package across multiple indexes.  We install PyTorch separately without
# hash-pinning (the index URL is the integrity guarantee here), then install
# everything else with --require-hashes.
RUN pip install --no-cache-dir \
        torch==1.13.1+cu116 \
        torchvision==0.14.1+cu116 \
        torchaudio==0.13.1 \
        --extra-index-url https://download.pytorch.org/whl/cu116

# Install PyG family (also from a project-specific index).
RUN pip install --no-cache-dir \
        pyg_lib torch_scatter torch_sparse \
        torch_cluster torch_spline_conv \
        -f https://data.pyg.org/whl/torch-1.13.0+cu116.html

# Install all remaining dependencies with hash verification.
# If requirements-hashes.txt is missing or stale, this step fails loudly.
RUN pip install --no-cache-dir --require-hashes \
    -r /workplace/requirements-hashes.txt

# ---- Additional dependencies not in setup.cfg --------------------------------
# These are explicitly listed here rather than in requirements-hashes.txt so
# that their hashes are tracked separately and can be updated without
# regenerating the full hash file.
RUN pip install --no-cache-dir \
        rdkit-pypi==2024.9.6 \
        sentence-transformers==3.4.1 \
        docling==2.18.0

# ---- Playwright browsers ----------------------------------------------------
# Install Playwright system deps and browser binaries (chromium only for eval).
RUN playwright install chromium \
    && playwright install-deps chromium

# ---- Supervisor (TCP server) -------------------------------------------------
COPY ai_researcher_runtime.supervisord.conf /etc/supervisor/conf.d/supervisord.conf
RUN mkdir -p /var/log/supervisor

EXPOSE 8000

# ---- Entrypoint (no credentials baked) ---------------------------------------
# The caller MUST mount or COPY the AI-Researcher source code into /app
# at container start time.  No source code is baked into this image.
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]