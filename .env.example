# ============================================================================
# ResearchClawEval — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ============================================================================

# --- LLM Provider (required) ---
# Your OpenAI-compatible API endpoint, key, and model.
OPENAI_BASE_URL=https://api.your-provider.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5.4

# --- Provider config for full runs (optional for smoke tests) ---
# Full runs use a TOML config file. Create one from the template:
#   cp provider.example.toml my_provider.toml
#   nano my_provider.toml
# PROVIDER_CONFIG=$PWD/my_provider.toml

# --- Framework source paths (optional) ---
# By default, frameworks are cloned into the repo root directory.
# Set these only if you placed frameworks in a custom location.
# RESEARCHCLAWEVAL_AI_RESEARCHER_ROOT=/path/to/AI-Researcher
# RESEARCHCLAWEVAL_AI_SCIENTIST_V2_ROOT=/path/to/AI-Scientist-v2
# RESEARCHCLAWEVAL_AUTORESEARCHCLAW_ROOT=/path/to/AutoResearchClaw

# --- Dataset paths (required for full runs) ---
# Download datasets with: bash scripts/setup_datasets.sh
# ARC_WBE_2026_DATASET_ROOT=/path/to/ARC_WBE_2026
# PSYDEFDETECT_DATASET_ROOT=/path/to/PsyDefDetect
# BABYLM_DATASET_ROOT=/path/to/BabyLM-2026-Strict-Small
# TDC_ADMET_TOX_DATASET_ROOT=/path/to/TDC-ADMET-Tox-public
# TOPIC2_DATASET_ROOT=/path/to/topic2