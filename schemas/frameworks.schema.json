{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchclaweval.dev/schemas/frameworks.schema.json",
  "type": "object",
  "required": ["schema_version", "frameworks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "upstream_url", "upstream_commit", "license_spdx", "adapter_manifest", "source_env", "source_dir", "api_dependencies", "supported_topics"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "upstream_url": {"type": "string", "pattern": "^https://github\\.com/.+\\.git$"},
          "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license_spdx": {"type": "string", "minLength": 1},
          "adapter_manifest": {"type": "string", "pattern": "^adapters/.+/manifest\\.json$"},
          "source_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "source_dir": {"type": "string", "minLength": 1},
          "api_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "supported_topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
