{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchclaweval.dev/schemas/topics.schema.json",
  "type": "object",
  "required": ["schema_version", "topics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "maturity", "contract_file", "dataset_env", "dataset_root", "supported_modes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "maturity": {"enum": ["stable", "beta", "legacy", "experimental"]},
          "contract_file": {"type": "string", "minLength": 1},
          "dataset_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "host_hidden_labels_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "dataset_external_dir": {"type": "string", "minLength": 1},
          "dataset_root": {"type": "string", "minLength": 1},
          "summary_files": {"type": "array", "items": {"type": "string"}},
          "supported_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["input_pack", "smoke", "fullrun"]}
          },
          "status": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
