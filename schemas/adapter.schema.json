{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchclaweval.dev/schemas/adapter.schema.json",
  "type": "object",
  "required": ["schema_version", "framework_id", "name", "upstream_url", "upstream_commit", "license_spdx", "native_entrypoint", "native_entrypoint_source", "admission_status", "supported_topics", "required_env", "required_images", "patches"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "framework_id": {"type": "string", "pattern": "^[0-9]{2}$"},
    "name": {"type": "string", "minLength": 1},
    "upstream_url": {"type": "string", "pattern": "^https://github\\.com/.+\\.git$"},
    "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license_spdx": {"type": "string", "minLength": 1},
    "native_entrypoint": {"type": ["string", "null"]},
    "native_entrypoint_source": {"type": "string", "minLength": 1},
    "admission_status": {"enum": ["candidate_requires_runtime_evidence", "unsupported_non_native"]},
    "supported_topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_env": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_images": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "patches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^patches/.+\\.patch$"}}
  }
}
