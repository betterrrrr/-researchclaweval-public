{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchclaweval.dev/schemas/leaderboard.schema.json",
  "type": "object",
  "required": ["schema_version", "results"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "campaign_id", "topic_id", "framework_id", "model", "provider", "adapter_commit", "research_completed", "scored", "contract_complete", "engineering_complete", "primary_score", "artifacts_url", "trace_url", "recorded_at"],
        "additionalProperties": false,
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "campaign_id": {"type": "string", "minLength": 1},
          "topic_id": {"type": "string", "minLength": 1},
          "framework_id": {"type": "string", "pattern": "^[0-9]{2}$"},
          "model": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "adapter_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "research_completed": {"type": "boolean"},
          "scored": {"type": "boolean"},
          "contract_complete": {"type": "boolean"},
          "engineering_complete": {"type": "boolean"},
          "primary_score": {"type": ["number", "null"]},
          "artifacts_url": {"type": ["string", "null"], "format": "uri"},
          "trace_url": {"type": ["string", "null"], "format": "uri"},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
